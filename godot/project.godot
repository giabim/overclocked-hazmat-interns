; Edit gameplay settings through Project Settings or focused changes.
config_version=5

[application]
config/name="Overclocked"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[debug]
gdscript/warnings/untyped_declaration=2

[input]
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
fire={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
throw={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":71), Object(InputEventMouseButton,"button_index":2)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
ping={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

[physics]
common/physics_ticks_per_second=30

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.078, 0.09, 0.102, 1)
